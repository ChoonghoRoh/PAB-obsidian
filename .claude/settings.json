{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(bash scripts/log-prompt.sh:*)",
      "Bash(./scripts/log-prompt.sh:*)",
      "Skill(project-config:*)",
      "Skill(ssot-reload:*)",
      "Skill(plan:*)",
      "Skill(phase-init:*)",
      "Skill(gate-check:*)",
      "Skill(rules-lookup:*)",
      "Skill(refactor-scan:*)",
      "Skill(verify-implementation:*)",
      "Skill(verify-backend:*)",
      "Skill(verify-frontend:*)",
      "Skill(context-handoff:*)",
      "Skill(worklog:*)",
      "Skill(report:*)",
      "Skill(menu:*)",
      "Skill(notify-telegram:*)",
      "Skill(wiki:*)",
      "Skill(worktree:*)",
      "Skill(abort:*)",
      "Skill(interop:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ssot-freshness-check.sh\"",
            "timeout": 10,
            "statusMessage": "SSOT 진입점 확인 중..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/log-prompt.sh\" init && \"$CLAUDE_PROJECT_DIR/scripts/log-prompt.sh\" check",
            "timeout": 10,
            "statusMessage": "오늘자 work-log 초기화 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/hr1-guard.sh\"",
            "timeout": 5,
            "statusMessage": "HR-1 코드 수정 규칙 확인 중..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lock1-guard.sh\"",
            "timeout": 5,
            "statusMessage": "LOCK-1 SSOT 수정 권한 확인 중..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sentinel.sh\" spawn",
            "timeout": 5,
            "statusMessage": "팀원 스폰 감지 — 팀 활성 센티넬 등록 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/line-count-monitor.sh\"",
            "timeout": 10,
            "statusMessage": "HR-5 줄수 모니터링 중..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/state-transition-guard.sh\"",
            "timeout": 5,
            "statusMessage": "상태 전이 유효성 검증 중..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/on-task-completed.sh\"",
            "timeout": 30,
            "statusMessage": "Task 완료 품질 검사 실행 중..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sentinel.sh\" start",
            "timeout": 5,
            "statusMessage": "팀원 스폰 감지 — 팀 활성 센티넬 등록 중..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sentinel.sh\" stop",
            "timeout": 5,
            "statusMessage": "팀원 종료 감지 — 팀 활성 센티넬 갱신 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-worklog-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "work-log 기록 확인 중..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sentinel.sh\" reconcile",
            "timeout": 5,
            "statusMessage": "팀원 상태 대조 중..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/team-sentinel.sh\" end",
            "timeout": 5,
            "statusMessage": "세션 종료 — 센티넬 정리 중..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-compact-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "FRESH-7 컨텍스트 복구 정보 수집 중..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-stack.sh\"",
            "timeout": 5,
            "statusMessage": "프롬프트 원문 적재 중..."
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/scripts/statusline.sh\""
  }
}
