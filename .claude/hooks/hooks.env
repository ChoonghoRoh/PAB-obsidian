PAB_PROJECT_NAME="PAB-obsidian"
PAB_PROJECT_TYPE="data"
PAB_CODE_DIRS="scripts"
PAB_CODE_EXTS="sh"
PAB_LINE_WARN=500
PAB_LINE_CRIT=700
PAB_COVERAGE_TARGET=80
PAB_NOTIFY_CHANNEL="telegram"
PAB_NOTIFY_LABEL="PAB-LLMDATA"
PAB_BUILD_CMD="none"
PAB_RUN_CMD="none"
PAB_TEST_CMD="bash scripts/zombiecheck/zombie_check.sh --self-test"
PAB_LINT_CMD="none"
PAB_SSOT_VERSION="v8.2-renewal-6th"
PAB_SSOT_PATH="docs/SSOT"
